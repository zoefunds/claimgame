# ==============================================================================
# CLAIMGAME — root environment reference. Copy the relevant lines into
# apps/web/.env.local and apps/api/.env — never fill in real secrets here.
# ==============================================================================

# ---- GenLayer StudioNet ------------------------------------------------------
# Deployed contract address (2026-08-25). Public — safe to expose to the
# frontend. Never hardcode this anywhere in source; read it from env only.
NEXT_PUBLIC_CLAIMGAME_CONTRACT_ADDRESS=0x4a4E1a6C3349E88707158fb15bE2F0f6560029Da
CLAIMGAME_CONTRACT_ADDRESS=0x4a4E1a6C3349E88707158fb15bE2F0f6560029Da

# StudioNet RPC endpoint used by the frontend SDK and the backend indexer.
# Fill in from your GenLayer Studio project settings.
NEXT_PUBLIC_GENLAYER_RPC_URL=
GENLAYER_RPC_URL=

# ---- Database (Fly Postgres) -------------------------------------------------
# Server-only. Set via `fly secrets set DATABASE_URL=...` in production.
DATABASE_URL=postgresql://user:password@localhost:5432/claimgame

# ---- Auth (wallet-based) -----------------------------------------------------
# Random 32+ byte secret for signing session JWTs. Server-only.
JWT_SIGNING_SECRET=
# Chain id used in the SIWE-style nonce message.
NEXT_PUBLIC_CHAIN_ID=

# ---- Backend ------------------------------------------------------------------
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
