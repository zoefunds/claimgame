# StudioNet's RPC + chain id are already baked into the `studionet` chain
# constant from genlayer-js (confirmed: https://studio.genlayer.com/api,
# chain id 61999) — these are only needed if you want to override that.
NEXT_PUBLIC_CLAIMGAME_CONTRACT_ADDRESS=0x019Dc784eA88d2F5E27a2924E08a8f1F195ca4B3
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Reown (WalletConnect) project id — public, identifies the app to the
# WalletConnect relay. Get your own at https://cloud.reown.com if you want
# a different one; this is the id provided for CLAIMGAME.
NEXT_PUBLIC_REOWN_PROJECT_ID=138176b654e2fdc1b7f6f263b8731372
