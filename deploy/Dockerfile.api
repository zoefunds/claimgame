# Builds apps/api (server) and apps/api indexer from the monorepo root.
# Context must be the repo root: `fly deploy --dockerfile deploy/Dockerfile.api`
FROM node:20-slim AS base
WORKDIR /repo
RUN corepack enable
# Prisma's query engine binary needs libssl at runtime — node:20-slim
# doesn't ship it, which surfaced as "libssl.so.1.1: cannot open shared
# object file" crash-looping the machine on first deploy.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile --filter @claimgame/api...

FROM deps AS build
COPY apps/api apps/api
RUN pnpm --filter @claimgame/api prisma:generate
RUN pnpm --filter @claimgame/api build

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /repo/apps/api/dist /repo/apps/api/dist
COPY --from=build /repo/apps/api/node_modules /repo/apps/api/node_modules
COPY --from=build /repo/apps/api/prisma /repo/apps/api/prisma
COPY --from=build /repo/node_modules /repo/node_modules
WORKDIR /repo/apps/api
EXPOSE 8080
CMD ["node", "dist/server.js"]
